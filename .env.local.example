# Local development overrides (loaded before .env)

APP_ENV=development
DEBUG=True
SECRET_KEY=dev-only-secret-key

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DOMAIN_URL=http://127.0.0.1:8000

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Leave blank to use sqlite for local development.
DATABASE_URL=

# Local Celery defaults (no Redis required).
CELERY_TASK_ALWAYS_EAGER=True
REDIS_URL=
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

# Optional integrations.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
MNOTIFY_API_KEY=
MNOTIFY_SENDER_ID=

# Console email backend is used when EMAIL_HOST is empty.
DEFAULT_FROM_EMAIL=noreply@example.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
